{
	"name": "psddb/image-focal-point",
	"description": "Set background focus position for media images.",
	"type": "project",
	"authors": [
		{
			"name": "Paul Walton"
		},
		{
			"name": "PS & Co",
			"email": "devops@psandco.ca"
		}
	],
	"require": {
		"php": ">=8.1",
		"psddb/wp-utils": "^2.0"
	},
	"require-dev": {
		"php-stubs/wordpress-stubs": "^6.6",
		"wp-cli/i18n-command": "^2.2.5"
	},
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/psddb/wp-utils"
		}
	],
	"scripts": {
		"lint": "@php ./vendor/bin/parallel-lint --exclude .git --exclude vendor .",
		"make-pot": "wp i18n make-pot . \"img-focal-point.pot\" --domain=\"img-focal-point\""
	}
